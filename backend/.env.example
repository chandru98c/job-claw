# ==========================================
# Job-Claw Backend Environment Configuration
# ==========================================

# 1. Database Connection (PostgreSQL with asyncpg driver)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/jobclaw

# 2. Redis Connection (Used for ARQ background task queues & semantic caching)
REDIS_URL=redis://localhost:6379/0

# 3. AI Providers & Semantic Recommendation Matching
# Dual LLM fallback sequence (comma-separated: GROQ, GEMINI)
LLM_SEQUENCE=GROQ,GEMINI

# Groq Cloud API (Free tier available at https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini API (https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Semantic Matching Feature Flags
ENABLE_SEMANTIC_SEARCH=true
MAX_SEMANTIC_CANDIDATES=20

# 4. ARQ Background Discovery Worker Settings
WORKER_CONCURRENCY=25
WORKER_MAX_TRIES=3
WORKER_JOB_TIMEOUT=300

# 5. Testing & Diagnostic Flags (Set to true in test suites)
TESTING=false

# 6. Optional ATS Adapter Overrides (if scraping private / credentialed endpoints)
# NAUKRI_NKPARAM=your_naukri_nkparam_if_applicable
