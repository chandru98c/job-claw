# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/jobclaw

# Redis / Queue
REDIS_URL=redis://localhost:6379/0

# AI Providers (Dual LLM Sequence Fallback)
GROQ_API_KEY=your-groq-api-key
GEMINI_API_KEY=your-gemini-api-key
LLM_SEQUENCE=GROQ,GEMINI

# Worker (ARQ) Settings
WORKER_CONCURRENCY=10
WORKER_MAX_TRIES=3
WORKER_JOB_TIMEOUT=300
REDIS_URL=redis://localhost:6379/0

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=true
