# ===============================================
# Job-Claw Root Environment Reference & Variables
# ===============================================

# -----------------------------------------------
# Backend Configuration (job-claw/backend/.env)
# -----------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/jobclaw
REDIS_URL=redis://localhost:6379/0

# LLM Providers (Dual Fallback)
LLM_SEQUENCE=GROQ,GEMINI
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Semantic Scoring Controls
ENABLE_SEMANTIC_SEARCH=true
MAX_SEMANTIC_CANDIDATES=20

# Background Worker Settings
WORKER_CONCURRENCY=25
WORKER_MAX_TRIES=3
WORKER_JOB_TIMEOUT=300

# -----------------------------------------------
# Frontend Configuration (job-claw/frontend/.env.local)
# -----------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
